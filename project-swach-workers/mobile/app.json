{
  "expo": {
    "name": "Swach worker",
    "slug": "swach-worker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rishben.swachworker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0d8483da-becd-42d2-9536-55ba8a02d2ab"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      "expo-audio"
    ]
  }
}
